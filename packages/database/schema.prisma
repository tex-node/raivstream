  status                MovieRenderStatus @default(QUEUED)
  filmBlueprintSnapshot Json
  audioBlueprintSnapshot Json?
  audioPlanVersionId    String?
  // Standalone hash of audioBlueprintSnapshot alone (hashAudioBlueprint()),
  // null for silent films. Distinct from renderPlanHash, which is the
  // COMBINED visual+audio idempotency key (combineRenderHash()) — this field
  // exists purely for render provenance/debugging (e.g. "did this render's
  // audio identity actually change between two jobs"), independent of the
  // idempotency mechanism.
  audioBlueprintHash    String?
  renderPlan            Json
  renderPlanHash        String
  rendererVersion       String            @default("phase-9b1-v1")
  progressPercent       Int               @default(0)
  currentStage          String?
  attemptCount          Int               @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  cancelledAt           DateTime?
  errorCode             String?
  errorMessage          String?
  // Phase 16.5 — retain each scene clip's native audio (MiniMax SFX) in the mix.
  keepNativeAudio       Boolean           @default(true)
  creditsReserved       Int               @default(0)
  creditsCharged        Int               @default(0)

  movieAsset            MovieAsset?
  events                MovieRenderEvent[]

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([projectId])
  @@index([sequenceId])
  @@index([userId])
  @@index([status])
  @@index([renderPlanHash])
  @@index([createdAt])
  @@map("movie_render_jobs")
}

