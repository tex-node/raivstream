// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VIEWER
  CREATOR
}

enum PremiumTier {
  FREE     // 5 free episodes then paywall
  VIEWER   // ₦1,500/month — unlimited watching
  CREATOR  // credit-based — buy credits to use AI features
}

enum CreditTxType {
  PURCHASE  // bought credits with money
  USAGE     // spent credits on a feature
  BONUS     // promotional / gift credits
  REFUND    // credits returned (e.g. failed generation)
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  MODERATION_REVIEW
  BLOCKED
}

enum GenerationModel {
  NANO_BANANA
  GROK_IMAGINE
  LTX2
  WAN_25
  KLING
  HIGGSFIELD
}

enum GenerationStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

enum BadgeType {
  TOP_VIEWED_WEEK
  TOP_LIKED_WEEK
  HIGHEST_ENGAGEMENT_WEEK
  VIEWERS_PICK_WEEK
  VIRAL_HIT
  CREATOR_MILESTONE_1K
  CREATOR_MILESTONE_10K
  CREATOR_MILESTONE_100K
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  username          String        @unique
  displayName       String
  passwordHash      String
  avatarUrl         String?
  bio               String?
  role              UserRole      @default(VIEWER)
  premiumTier       PremiumTier   @default(FREE)
  premiumUntil      DateTime?
  verified          Boolean       @default(false)

  // Security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Stats
  followerCount     Int           @default(0)
  followingCount    Int           @default(0)
  totalViews        Int           @default(0)
  totalLikes        Int           @default(0)

  // Relations
  videos             Video[]       @relation("CreatorVideos")
  interactions       VideoInteraction[]
  watchHistory       WatchHistory[]
  following          Follow[]      @relation("Follower")
  followers          Follow[]      @relation("Following")
  badges             UserBadge[]
  subscriptions      Subscription[]
  refreshTokens      RefreshToken[]
  generationJobs     GenerationJob[]
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]
  passwordResetTokens PasswordResetToken[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([username])
  @@index([premiumTier])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Video {
  id                String        @id @default(cuid())
  creatorId         String
  creator           User          @relation("CreatorVideos", fields: [creatorId], references: [id], onDelete: Cascade)
  
  // Metadata
  title             String
  description       String?
  thumbnailUrl      String
  duration          Int
  aspectRatio       String        @default("9:16")
  
  // Video files
  rawVideoUrl       String?   // original upload key in R2 (private bucket)
  mp4Url            String?   // CDN-served MP4 URL (set after confirmUpload)
  hlsMasterUrl      String?   // HLS .m3u8 URL (set after transcoding)
  hlsPath           String?
  
  status            VideoStatus   @default(UPLOADING)
  
  // Categorization
  tags              String[]
  categories        VideoCategory[]
  
  // Stats (denormalized for performance)
  viewCount         Int           @default(0)
  uniqueViewCount   Int           @default(0)
  likeCount         Int           @default(0)
  dislikeCount      Int           @default(0)
  starRatingSum     Int           @default(0)
  starRatingCount   Int           @default(0)
  avgStarRating     Float         @default(0)
  commentCount      Int           @default(0)
  shareCount        Int           @default(0)
  completionRate    Float         @default(0)
  avgWatchTime      Float         @default(0)
  
  // Engagement score (computed periodically)
  engagementScore   Float         @default(0)
  
  // Visibility
  isPublic          Boolean       @default(true)
  isPremiumOnly     Boolean       @default(false)
  
  // Relations
  interactions      VideoInteraction[]
  watchHistory      WatchHistory[]
  badges            VideoBadge[]
  featuredIn        FeaturedContent[]
  generationJob     GenerationJob?
  
  publishedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([creatorId])
  @@index([status])
  @@index([publishedAt])
  @@index([engagementScore])
  @@index([viewCount])
  @@index([avgStarRating])
  @@index([tags])
  @@index([creatorId, status])
  @@map("videos")
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  icon        String?
  videos      VideoCategory[]
  
  createdAt   DateTime        @default(now())
  
  @@map("categories")
}

model VideoCategory {
  videoId    String
  categoryId String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([videoId, categoryId])
  @@map("video_categories")
}

model VideoInteraction {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  // Interaction types
  liked       Boolean   @default(false)
  disliked    Boolean   @default(false)
  starRating  Int?
  
  // Watch metrics
  watchTime   Int       @default(0)
  completed   Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([liked])
  @@index([starRating])
  @@index([completed])
  @@index([userId, updatedAt])
  @@map("video_interactions")
}

model WatchHistory {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  watchTime   Int
  completed   Boolean   @default(false)
  lastPosition Int      @default(0)
  
  watchedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, videoId])
  @@index([userId, watchedAt])
  @@index([videoId])
  @@map("watch_history")
}

model Follow {
  followerId  String
  followingId String
  follower    User      @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Badge {
  id          String      @id @default(cuid())
  type        BadgeType   @unique
  name        String
  description String
  iconUrl     String
  
  userBadges  UserBadge[]
  videoBadges VideoBadge[]
  
  createdAt   DateTime    @default(now())
  
  @@map("badges")
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  awardedAt   DateTime  @default(now())
  
  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model VideoBadge {
  id          String    @id @default(cuid())
  videoId     String
  badgeId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  week        String
  
  awardedAt   DateTime  @default(now())
  
  @@unique([videoId, badgeId, week])
  @@index([videoId])
  @@index([week])
  @@map("video_badges")
}

model FeaturedContent {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  section     String
  position    Int
  week        String?
  
  startDate   DateTime  @default(now())
  endDate     DateTime?
  
  createdAt   DateTime  @default(now())
  
  @@index([section, startDate])
  @@index([week])
  @@map("featured_content")
}

model Subscription {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment provider: "paystack" | "stripe"
  provider String @default("paystack")

  // Paystack (primary — local payments)
  paystackCustomerCode     String? @unique
  paystackSubscriptionCode String? @unique
  paystackPlanCode         String?

  // Stripe (international payments — future)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  tier   PremiumTier
  status String // active | cancelled | past_due | expired

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Credit System ─────────────────────────────────────────────────────────────

model CreditBalance {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

model CreditTransaction {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Int          // positive = credit in, negative = credit out
  type        CreditTxType
  featureKey  String?      // which feature was used (populated on USAGE)
  description String?
  referenceId String?      // payment ref, generation job ID, etc.

  balanceBefore Int
  balanceAfter  Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

// Admin-configurable credit cost per feature key
// e.g. featureKey="generate:kling" creditsPerUnit=500
//      featureKey="generate:nano_banana" creditsPerUnit=100
//      featureKey="thumbnail:ai" creditsPerUnit=50
model FeatureCreditRate {
  id             String  @id @default(cuid())
  featureKey     String  @unique // namespaced: "category:feature"
  creditsPerUnit Int
  unitLabel      String  @default("request") // "request" | "second" | "image"
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("feature_credit_rates")
}

model GenerationJob {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What model was used
  model           GenerationModel

  // Prompt inputs
  prompt          String
  negativePrompt  String?

  // Generation parameters
  duration        Float            @default(5)
  aspectRatio     String           @default("9:16")
  style           String?
  seedImageUrl    String?          // optional image for image-to-video models

  // Job lifecycle
  status          GenerationStatus @default(QUEUED)
  providerJobId   String?          // external job/prediction ID from the AI provider
  outputUrl       String?          // final generated video URL
  thumbnailUrl    String?          // extracted thumbnail from generated video
  errorMessage    String?

  // If the user publishes the generated video, link it here
  videoId         String?          @unique
  video           Video?           @relation(fields: [videoId], references: [id], onDelete: SetNull)

  // Billing
  creditsUsed     Int              @default(1)

  // Extra provider-specific metadata (seed, dimensions, etc.)
  metadata        Json?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([model])
  @@index([userId, createdAt])
  @@map("generation_jobs")
}

// One-time tokens for password reset emails.
// The raw token is sent in the reset link; only its bcrypt hash is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    // bcrypt hash of the URL-safe random token
  expiresAt DateTime  // 1 hour from creation
  usedAt    DateTime? // set when the token is consumed (prevents reuse)

  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
