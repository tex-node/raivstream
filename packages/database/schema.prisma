enum AcademyCommentTargetType {
  STORY
  CHARACTER
  SCENE
  ASSET
  STORYBOOK
  SUBMISSION
}

enum AcademyLessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum BadgeType {
  TOP_VIEWED_WEEK
  TOP_LIKED_WEEK
  HIGHEST_ENGAGEMENT_WEEK
  VIEWERS_PICK_WEEK
  VIRAL_HIT
  CREATOR_MILESTONE_1K
  CREATOR_MILESTONE_10K
  CREATOR_MILESTONE_100K
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  username          String        @unique
  displayName       String
  passwordHash      String?   // null for Google-only accounts (no password set)
  googleId          String?   @unique // Google OAuth subject — set on first Google sign-in
  avatarUrl         String?
  bio               String?
  role              UserRole      @default(VIEWER)
  premiumTier       PremiumTier   @default(FREE)
  premiumUntil      DateTime?
  verified          Boolean       @default(false)

  // Security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Stats
  followerCount     Int           @default(0)
  followingCount    Int           @default(0)
  totalViews        Int           @default(0)
  totalLikes        Int           @default(0)

  // Relations
  videos             Video[]       @relation("CreatorVideos")
  interactions       VideoInteraction[]
  watchHistory       WatchHistory[]
  following          Follow[]      @relation("Follower")
  followers          Follow[]      @relation("Following")
  badges             UserBadge[]
  subscriptions      Subscription[]
  refreshTokens      RefreshToken[]
  generationJobs     GenerationJob[]
  movieRenderJobs    MovieRenderJob[]
  audioAssets        AudioAsset[]
  storyProjects       StoryProject[]
  academyCoursesOwned AcademyCourse[] @relation("AcademyCourseOwner")
  academyClassesInstructing AcademyClass[] @relation("AcademyClassInstructor")
  academyMemberships  AcademyClassMembership[]
  academySubmissions  AcademySubmission[] @relation("AcademySubmissionStudent")
  academyComments     AcademyComment[] @relation("AcademyCommentAuthor")
  academyLessonProgress AcademyLessonProgress[]
  analyticsEvents     AnalyticsEvent[]
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]
  creditOperations    CreditOperation[]
  creditReservations  CreditReservation[]
  passwordResetTokens PasswordResetToken[]
  notifications       Notification[] @relation("ReceivedNotifications")
  sentNotifications   Notification[] @relation("SentNotifications")

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([username])
  @@index([premiumTier])
  @@index([role])
  @@map("users")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId  String?
  eventName  String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([projectId])
  @@index([eventName])
  @@index([createdAt])
  @@index([eventName, createdAt])
  @@map("analytics_events")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  family     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model Video {
  id                String        @id @default(cuid())
  creatorId         String
  creator           User          @relation("CreatorVideos", fields: [creatorId], references: [id], onDelete: Cascade)
  
  // Metadata
  title             String
  description       String?
  thumbnailUrl      String
  duration          Int
  aspectRatio       String        @default("9:16")
  
  // Video files
  rawVideoUrl       String?   // original upload key in R2 (private bucket)
  mp4Url            String?   // CDN-served MP4 URL (set after confirmUpload)
  hlsMasterUrl      String?   // HLS .m3u8 URL (set after transcoding)
  hlsPath           String?
  
  status            VideoStatus   @default(UPLOADING)
  
  // Categorization
  tags              String[]
  categories        VideoCategory[]
  
  // Stats (denormalized for performance)
  viewCount         Int           @default(0)
  uniqueViewCount   Int           @default(0)
  likeCount         Int           @default(0)
  dislikeCount      Int           @default(0)
  starRatingSum     Int           @default(0)
  starRatingCount   Int           @default(0)
  avgStarRating     Float         @default(0)
  commentCount      Int           @default(0)
  shareCount        Int           @default(0)
  completionRate    Float         @default(0)
  avgWatchTime      Float         @default(0)
  
  // Engagement score (computed periodically)
  engagementScore   Float         @default(0)
  
  // Visibility
  isPublic          Boolean       @default(true)
  isPremiumOnly     Boolean       @default(false)

  // Content rating / moderation
  isKidsSafe        Boolean          @default(false)
  contentRating     String?          // "G" | "PG" | "PG-13" | "R"
  moderationStatus  ModerationStatus @default(PENDING)

  // Relations
  interactions      VideoInteraction[]
  watchHistory      WatchHistory[]
  badges            VideoBadge[]
  featuredIn        FeaturedContent[]
  generationJob     GenerationJob?
  moderationLogs    ModerationLog[]
  notifications     Notification[]
  
  publishedAt       DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  @@index([creatorId])
  @@index([status])
  @@index([publishedAt])
  @@index([engagementScore])
  @@index([viewCount])
  @@index([avgStarRating])
  @@index([tags])
  @@index([creatorId, status])
  @@index([moderationStatus])
  @@map("videos")
}

model ModerationLog {
  id           String    @id @default(cuid())
  videoId      String
  video        Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  moderatorId  String?   // null = automated action
  action       String    // "approve" | "reject" | "flag" | "auto_approve" | "auto_reject"
  reason       String?
  automated    Boolean   @default(false)
  confidence   Float?    // AI confidence score (0–1) for automated decisions
  createdAt    DateTime  @default(now())

  @@index([videoId])
  @@index([moderatorId])
  @@index([createdAt])
  @@map("moderation_logs")
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  slug        String          @unique
  description String?
  icon        String?
  videos      VideoCategory[]
  
  createdAt   DateTime        @default(now())
  
  @@map("categories")
}

model VideoCategory {
  videoId    String
  categoryId String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([videoId, categoryId])
  @@map("video_categories")
}

model VideoInteraction {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  // Interaction types
  liked       Boolean   @default(false)
  disliked    Boolean   @default(false)
  starRating  Int?
  
  // Watch metrics
  watchTime   Int       @default(0)
  completed   Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([liked])
  @@index([starRating])
  @@index([completed])
  @@index([userId, updatedAt])
  @@map("video_interactions")
}

model WatchHistory {
  id          String    @id @default(cuid())
  userId      String
  videoId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  watchTime   Int
  completed   Boolean   @default(false)
  lastPosition Int      @default(0)
  
  watchedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([userId, videoId])
  @@index([userId, watchedAt])
  @@index([videoId])
  @@map("watch_history")
}

model Follow {
  followerId  String
  followingId String
  follower    User      @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  
  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Badge {
  id          String      @id @default(cuid())
  type        BadgeType   @unique
  name        String
  description String
  iconUrl     String
  
  userBadges  UserBadge[]
  videoBadges VideoBadge[]
  
  createdAt   DateTime    @default(now())
  
  @@map("badges")
}

model UserBadge {
  id          String    @id @default(cuid())
  userId      String
  badgeId     String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  awardedAt   DateTime  @default(now())
  
  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model VideoBadge {
  id          String    @id @default(cuid())
  videoId     String
  badgeId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  badge       Badge     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  week        String
  
  awardedAt   DateTime  @default(now())
  
  @@unique([videoId, badgeId, week])
  @@index([videoId])
  @@index([week])
  @@map("video_badges")
}

model FeaturedContent {
  id          String    @id @default(cuid())
  videoId     String
  video       Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  section     String
  position    Int
  week        String?
  
  startDate   DateTime  @default(now())
  endDate     DateTime?
  
  createdAt   DateTime  @default(now())
  
  @@index([section, startDate])
  @@index([week])
  @@map("featured_content")
}

model Subscription {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Payment provider: "paystack" | "stripe"
  provider String @default("paystack")

  // Paystack (primary — local payments)
  paystackCustomerCode     String? @unique
  paystackSubscriptionCode String? @unique
  paystackPlanCode         String?

  // Stripe (international payments — future)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  tier   PremiumTier
  status String // active | cancelled | past_due | expired

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// ─── Credit System ─────────────────────────────────────────────────────────────

model CreditBalance {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

model CreditTransaction {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount      Int          // positive = credit in, negative = credit out
  type        CreditTxType
  featureKey  String?      // which feature was used (populated on USAGE)
  description String?
  referenceId String?      // payment ref, generation job ID, etc.

  balanceBefore Int
  balanceAfter  Int

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
  @@map("credit_transactions")
}

// Durable outbox for credit operations (e.g. crash-safe refunds).
// `idempotencyKey` is unique, so a refund intent can be created exactly once,
// atomically with the GenerationJob terminal transition. A pending row survives
// process crashes and can be retried until it reaches COMPLETED.
enum CreditOperationType {
  REFUND
}

enum CreditOperationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model CreditOperation {
  id             String                @id @default(cuid())
  idempotencyKey String                @unique
  type           CreditOperationType   @default(REFUND)
  status         CreditOperationStatus @default(PENDING)

  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJobId String? // plain reference (not an FK) to stay decoupled, like AnalyticsEvent.projectId
  featureKey      String?
  amount          Int // positive credits to return
  referenceId     String? // mirrors idempotencyKey for the resulting CreditTransaction
  attempts        Int      @default(0)
  lastError       String? // redacted message only; never secrets

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
  @@index([generationJobId])
  @@map("credit_operations")
}

// Credit reservation lifecycle for the reserve → settle → release pattern
// (Phase §7.5). Flag-guarded: only used when CREDIT_RESERVE_SETTLE_ENABLED=true.
// `idempotencyKey` is unique so a reservation is created exactly once and can
// survive process crashes between reserve and settle/release.
enum CreditReservationStatus {
  HELD
  SETTLED
  RELEASED
}

model CreditReservation {
  id             String                  @id @default(cuid())
  idempotencyKey String                  @unique
  status         CreditReservationStatus @default(HELD)

  userId          String
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  generationJobId String?
  featureKey      String?
  amount          Int     // estimated credits held
  settledAmount   Int?    // actual credits charged (set on SETTLED)
  referenceId     String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  settledAt  DateTime?
  releasedAt DateTime?

  @@index([status, createdAt])
  @@index([userId])
  @@map("credit_reservations")
}

// Admin-configurable credit cost per feature key
// e.g. featureKey="generate:kling" creditsPerUnit=500
//      featureKey="generate:nano_banana" creditsPerUnit=100
//      featureKey="thumbnail:ai" creditsPerUnit=50
model FeatureCreditRate {
  id             String  @id @default(cuid())
  featureKey     String  @unique // namespaced: "category:feature"
  creditsPerUnit Int
  unitLabel      String  @default("request") // "request" | "second" | "image"
  description    String?
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("feature_credit_rates")
}

model GenerationJob {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What model was used
  model           GenerationModel

  // Prompt inputs
  prompt          String
  negativePrompt  String?

  // Generation parameters
  duration        Float            @default(5)
  aspectRatio     String           @default("9:16")
  style           String?
  seedImageUrl    String?          // optional image for image-to-video models
  audioUrl        String?          // optional audio for talking-video models (VEED Fabric)
  resolution      String?          // output resolution preset (MiniMax H3: 480p/720p/768p/1080p)

  // Job lifecycle
  status          GenerationStatus @default(QUEUED)
  providerJobId   String?          // external job/prediction ID from the AI provider
  outputUrl       String?          // final generated video URL
  thumbnailUrl    String?          // extracted thumbnail from generated video
  errorMessage    String?
  errorCode       String?          // normalized error code (Phase §7.2)
  retryCount      Int              @default(0) // provider retries (Phase 15)

  // If the user publishes the generated video, link it here
  videoId         String?          @unique
  video           Video?           @relation(fields: [videoId], references: [id], onDelete: SetNull)

  // Billing
  creditsUsed     Int              @default(1)

  // Extra provider-specific metadata (seed, dimensions, etc.)
  metadata        Json?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@index([model])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, retryCount])
  @@index([errorCode])
  @@map("generation_jobs")
}

model StoryProject {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  title          String
  originalIdea   String?
  logline        String?
  synopsis       String?
  genre          String?
  tone           String?
  targetAudience String?
  audienceMode   StoryAudienceMode  @default(GENERAL)
  storyType      StoryType          @default(SHORT_STORY)
  ageRange       String?
  theme          String?
  visualStyle    String?
  storyDna       Json?
  status         StoryProjectStatus @default(DRAFT)
  creativeCriticMode CreativeCriticMode @default(SUGGEST)
  creativeCriticThreshold Int?
  creativeCriticMaxRetries Int?
  lastWorkspaceTab String?
  // Phase 16.5 — persisted ProductionManifest (MiniMax H3 + ElevenLabs spec).
  productionManifest Json?
  productionManifestUpdatedAt DateTime?
  // Phase 11 — project cover (share/OG image); a ready scene image asset.
  coverAssetId   String?
  coverAsset     StorySceneAsset? @relation("ProjectCover", fields: [coverAssetId], references: [id], onDelete: SetNull)

  characters     StoryCharacter[]
  environments   StoryEnvironment[]
  shots          StoryboardShot[]
  questions      StoryQuestion[]
  chapters       StoryChapter[]
  characterMemory StoryCharacterMemory[]
  sceneSeeds     StorySceneSeed[]
  sequences      StorySequence[]
  movieRenderJobs MovieRenderJob[]
  movieAssets     MovieAsset[]
  audioPerformancePlans AudioPerformancePlan[]
  voiceProfiles   VoiceProfile[]
  audioAssets     AudioAsset[]
  academySubmissions AcademySubmission[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([audienceMode])
  @@index([userId, updatedAt])
  @@map("story_projects")
}

model AcademyCourse {
  id                     String              @id @default(cuid())
  ownerId                String
  owner                  User                @relation("AcademyCourseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title                  String
  description            String?
  learningOutcome        String?
  audienceDescription    String?
