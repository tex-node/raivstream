// ─── Audio & Performance Layer (Phase 9B.2) ────────────────────────────────────
//
// Story → Scenes → Sequence / Film Blueprint → Audio & Performance Plan →
// Audiovisual Render Plan → Movie
//
// AudioPerformancePlan is scoped to one StorySequence (its Film Blueprint is
// the canonical visual timeline audio cues attach to). Cue timing is always
// expressed in canonical finished-film seconds — the same timeline
// StorySequenceScene.durationSeconds already represents — never derived from
// FFmpeg transition/xfade handles.
//
// Provider-specific generation metadata (TTS provider, model id, signed URLs)
// must not appear on the creative model. AudioCue references a
// provider-neutral VoiceProfile; execution/provider details belong in future
// generation-job records, not here.

enum AudioPlanStatus {
  DRAFT
  LOCKED
  ARCHIVED
}

enum AudioTrackType {
  NARRATION
  DIALOGUE
  AMBIENCE
  SFX
  MUSIC
}

model AudioPerformancePlan {
  id                   String                 @id @default(cuid())
  projectId            String
  project              StoryProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequenceId           String
  sequence             StorySequence          @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  status               AudioPlanStatus        @default(DRAFT)
  currentVersionNumber Int                    @default(0)

  tracks               AudioTrack[]
  versions             AudioPlanVersion[]

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([projectId])
  @@index([sequenceId])
  @@index([sequenceId, status])
  @@map("audio_performance_plans")
}

model AudioTrack {
  id        String         @id @default(cuid())
  planId    String
  plan      AudioPerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  type      AudioTrackType
  name      String
  enabled   Boolean        @default(true)
  volume    Float          @default(1)
  order     Int            @default(0)

  cues      AudioCue[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([planId])
  @@index([planId, order])
  @@index([planId, type])
  @@map("audio_tracks")
}

model AudioCue {
  id                    String         @id @default(cuid())
  trackId               String
  track                 AudioTrack     @relation(fields: [trackId], references: [id], onDelete: Cascade)

  // Optional canonical-timeline / creative-entity anchors. Nullable because a
  // music or ambience cue may span multiple scenes, and an SFX/ambience cue
  // has no speaking character.
  sequenceSceneId       String?
  sequenceScene         StorySequenceScene? @relation(fields: [sequenceSceneId], references: [id], onDelete: SetNull)
  characterMemoryId     String?
  characterMemory       StoryCharacterMemory? @relation(fields: [characterMemoryId], references: [id], onDelete: SetNull)
  voiceProfileId        String?
  voiceProfile          VoiceProfile?  @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)
  audioAssetId          String?
  audioAsset            AudioAsset?    @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)

  enabled               Boolean        @default(true)
  order                 Int            @default(0)

  // Canonical finished-film timeline position — never an FFmpeg render handle.
  startTimeSeconds      Float
  durationSeconds       Float?
  trimStartSeconds      Float?
  trimEndSeconds        Float?

  volume                Float          @default(1)
  fadeInSeconds          Float?
  fadeOutSeconds         Float?

  // Speech-only fields (NARRATION / DIALOGUE tracks).
  text                  String?
  performancePreset     String?
  performanceDirection  String?

  // Deterministic mix-time ducking intent (never baked into source assets).
  duckingEnabled        Boolean        @default(false)
  duckingAmountDb       Float?

  metadata              Json?

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([trackId])
  @@index([trackId, startTimeSeconds])
  @@index([sequenceSceneId])
  @@index([characterMemoryId])
  @@index([voiceProfileId])
  @@index([audioAssetId])
  @@map("audio_cues")
}

model VoiceProfile {
  id                String         @id @default(cuid())
  projectId         String
  project           StoryProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  characterMemoryId String?
  characterMemory   StoryCharacterMemory? @relation(fields: [characterMemoryId], references: [id], onDelete: SetNull)

  name              String
  voiceType         String?        // free text role, e.g. "NARRATOR" | "CHARACTER" — intentionally not a rigid enum
  voiceRef          String?        // provider-neutral voice reference/handle, never a raw provider model id
  language          String?        @default("en")
  accentStyle       String?
  pitch             Float?
  rate              Float?
  styleNotes        String?

  cues              AudioCue[]

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([projectId])
  @@index([characterMemoryId])
  @@map("voice_profiles")
}

model AudioPlanVersion {
  id             String               @id @default(cuid())
  planId         String
  plan           AudioPerformancePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  versionNumber  Int
  title          String
  snapshot       Json
  audioBlueprint Json?
  runtimeSeconds Float                @default(0)
  createdById    String
  notes          String?

  createdAt      DateTime             @default(now())

  @@unique([planId, versionNumber])
  @@index([planId])
  @@index([createdById])
  @@map("audio_plan_versions")
}

model AudioAsset {
  id              String       @id @default(cuid())
  projectId       String
  project         StoryProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  storageProvider String       @default("R2")
  storageKey      String
  publicUrl       String?
  mimeType        String       @default("audio/mpeg")
  durationSeconds Float?
  fileSizeBytes   Int?
  checksum        String?
  sampleRateHz    Int?
  channels        Int?
  sourceKind      String?      // free text, e.g. "UPLOAD" | "SYNTHETIC_TEST" — not a rigid enum

  cues            AudioCue[]

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projectId])
  @@index([userId])
  @@map("audio_assets")
}

// ─── Raivstream 5.0 — Creative Foundation (semantic orchestration layer) ─────
// Additive only. Sits ABOVE the legacy Story domain; legacy StoryProject is
// bridged via CreativeProject.legacyStoryProjectId (nullable). Columns follow
// the repo's camelCase convention.

enum CreativeProjectType {
  STORY
  EDUCATION
  COMMERCIAL
  TRANSFORMATION
  UNKNOWN
}

enum CreativeProjectStatus {
  IDEA
  INTERPRETING
  PLANNING
  PREVIEW
  DIRECTING
  GENERATING
  REVIEW
  REFINING
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum CreativeMemoryKind {
  PREFERENCE
  DECISION
  REJECTION
  NOTE
  DIRECTION
}

enum CreativeProducedAssetKind {
  IMAGE
  VIDEO
}

enum CreativeProducedAssetStatus {
  QUEUED
  GENERATING
  READY
  FAILED
}

enum CreativeDirectiveMode {
  DIRECT
  EXPLORE
  REVIEW
}

enum CreativeImpactLevel {
  NONE
  LOCAL
  MULTI_SCENE
  PROJECT
  OUTPUT
}

enum CreativeReviewRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum CreativeReviewResolutionKind {
  KEEP
  FIX
  REVIEW
}

model CreativeProject {
  id                   String                @id @default(cuid())
  userId               String
  title                String
  projectType          CreativeProjectType   @default(UNKNOWN)
  status               CreativeProjectStatus @default(IDEA)
  legacyStoryProjectId String?
  brief                CreativeBrief?
  bible                CreativeBible?
  memories             CreativeMemory[]
  productionPlan       CreativeProductionPlan?
  producedAssets       CreativeProducedAsset[]
  versions             CreativeVersion[]
  directives           CreativeDirective[]
  reviewRuns           CreativeReviewRun[]
  currentVersionId     String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([userId])
  @@index([status])
  @@index([legacyStoryProjectId])
  @@map("creative_projects")
}

model CreativeBrief {
  id              String         @id @default(cuid())
  projectId       String         @unique
  project         CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  originalIntent  String
  refinedIntent   String?
  objective       String?
  audience        String?
  format          String?
  durationSeconds Int?
  genre           String?
  tone            String?
  theme           String?
  setting         String?
  attachments     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("creative_briefs")
}

model CreativeBible {
  id             String         @id @default(cuid())
  projectId      String         @unique
  project        CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version        Int            @default(1)
  story          Json?
  characters     Json?
  worlds         Json?
  visualLanguage Json?
  audioLanguage  Json?
  audience       Json?
  brand          Json?
  constraints    Json?
  canon          Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("creative_bibles")
}

model CreativeMemory {
  id        String            @id @default(cuid())
  projectId String
  project   CreativeProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      CreativeMemoryKind
  content   Json
  createdAt DateTime          @default(now())

  @@index([projectId])
  @@map("creative_memories")
}

model CreativeProductionPlan {
  id        String         @id @default(cuid())
  projectId String         @unique
  project   CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version   Int            @default(1)
  plan      Json
  preview   Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("creative_production_plans")
}

model CreativeProducedAsset {
  id            String                        @id @default(cuid())
  projectId     String
  project       CreativeProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId       String
  shotId        String?
  kind          CreativeProducedAssetKind
  status        CreativeProducedAssetStatus   @default(QUEUED)
  assetUrl      String?
  thumbnailUrl  String?
  errorMessage  String?
  provider      String?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([projectId, sceneId])
  @@index([projectId, status])
  @@map("creative_produced_assets")
}

model CreativeVersion {
  id            String          @id @default(cuid())
  projectId     String
  project       CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionNumber Int
  label         String?
  description   String?
  snapshot      Json
  createdAt     DateTime        @default(now())

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("creative_versions")
}

model CreativeDirective {
  id               String                @id @default(cuid())
  projectId        String
  project          CreativeProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versionId        String?
  mode             CreativeDirectiveMode
  instruction      String
  interpretation   String
  change           Json
  preserve         Json
  impact           CreativeImpactLevel
  scopes           Json
  approvalRequired Boolean               @default(true)
  executionPlan    Json
  createdAt        DateTime              @default(now())

  @@index([projectId])
  @@map("creative_directives")
}

model CreativeReviewRun {
  id        String                 @id @default(cuid())
  projectId String
  project   CreativeProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId   String?
  assetId   String?
  status    CreativeReviewRunStatus @default(PENDING)
  findings  Json
  provider  String?
  resolutions CreativeReviewResolution[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([projectId])
  @@map("creative_review_runs")
}

model CreativeReviewResolution {
  id         String                         @id @default(cuid())
  runId      String
  run        CreativeReviewRun              @relation(fields: [runId], references: [id], onDelete: Cascade)
  findingId  String
  resolution CreativeReviewResolutionKind
  createdAt  DateTime                       @default(now())

  @@unique([runId, findingId])
  @@map("creative_review_resolutions")
}
