// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VIEWER
  CREATOR
  MODERATOR
  ADMIN
}

enum PremiumTier {
  FREE     // Guest users get 50 free episodes; signed-in FREE users get 10 before premium-only locks
  VIEWER   // ₦1,500/month — unlimited watching
  CREATOR  // credit-based — buy credits to use AI features
}

enum CreditTxType {
  PURCHASE  // bought credits with money
  USAGE     // spent credits on a feature
  BONUS     // promotional / gift credits
  REFUND    // credits returned (e.g. failed generation)
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  MODERATION_REVIEW
  BLOCKED
}

enum ModerationStatus {
  PENDING    // newly uploaded, awaiting review
  APPROVED   // cleared for the feed
  REJECTED   // removed (not shown in any feed)
  FLAGGED    // user-reported, needs moderator attention
}

enum GenerationModel {
  NANO_BANANA
  GROK_IMAGINE
  LTX2
  WAN_25
  KLING         // legacy — superseded by KLING_I2V / KLING_R2V
  KLING_I2V     // Kling image-to-video (seed image = opening frame)
  KLING_R2V     // Kling reference-to-video (seed image guides style/subject)
  HIGGSFIELD
  VEO3
  FLUX
  HUNYUAN_VIDEO
  COG_VIDEO_X
  SEEDANCE
  FLUX2        // fal.ai FLUX.2 text-to-image (fal-ai/flux-2)
  H3_MAX       // fal.ai MiniMax H3-Max image-to-video (minimax/h3-max/image-to-video)
  VEED_FABRIC  // fal.ai VEED Fabric 1.0 talking-video lip-sync (veed/fabric-1.0)
}

enum GenerationStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
  CANCELLED
}

enum StoryProjectStatus {
  DRAFT
  GENERATED
  EXTENDED
  STORYBOARDED
  IN_PRODUCTION
  PUBLISHED
  ARCHIVED
}

enum StoryboardShotType {
  IMAGE
  VIDEO
}

enum StoryAudienceMode {
  KIDS
  GENERAL
}

enum StoryType {
  SHORT_STORY
  PICTURE_BOOK
  COMIC
  VIDEO_STORY
}

enum StoryPromptOutputType {
  IMAGE
  SHORT_VIDEO
  COMIC_PANEL
}

enum StorySceneAssetType {
  IMAGE
  VIDEO
}

enum StorySceneAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

enum CreativeCriticRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum CreativeCriticRecommendation {
  APPROVE
  SUGGEST_REFINEMENT
  REGENERATE
}

enum CreativeCriticMode {
  OFF
  SUGGEST
  AUTO_ONCE
  AUTO_UNTIL_THRESHOLD
}

enum CreativeAssetStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum StorySequenceStatus {
  DRAFT
  LOCKED
  ARCHIVED
}

enum SequenceShotType {
  EXTREME_WIDE
  WIDE
  MEDIUM_WIDE
  MEDIUM
  MEDIUM_CLOSE_UP
  CLOSE_UP
  EXTREME_CLOSE_UP
  POV
  OVER_THE_SHOULDER
  HIGH_ANGLE
  LOW_ANGLE
  TRACKING
}

enum SequenceCameraMovement {
  NONE
  STATIC
  PAN_LEFT
  PAN_RIGHT
  TILT_UP
  TILT_DOWN
  PUSH_IN
  PULL_OUT
  TRACK_LEFT
  TRACK_RIGHT
  ORBIT
  DOLLY
  CRANE
  HANDHELD
}

enum SequenceCameraSpeed {
  SLOW
  NORMAL
  FAST
  CUSTOM
}

enum SequenceTransitionType {
  CUT
  CROSS_DISSOLVE
  FADE
  DIP_TO_BLACK
  DIP_TO_WHITE
  MATCH_CUT
  WIPE
  NONE
}

enum MovieRenderStatus {
  QUEUED
  PREPARING
  RENDERING_SHOTS
  ASSEMBLING
  ENCODING
  VERIFYING
  UPLOADING
  READY
  FAILED
  CANCELLED
}

enum MovieAssetStatus {
  READY
  ARCHIVED
  FAILED
}

enum NotificationType {
  FOLLOW  // someone followed you
  LIKE    // someone liked your video
  ACADEMY_STUDENT_JOINED
  ACADEMY_ASSIGNMENT_PUBLISHED
  ACADEMY_SUBMISSION_RECEIVED
  ACADEMY_REVISION_REQUESTED
  ACADEMY_SUBMISSION_APPROVED
  ACADEMY_GRADE_RELEASED
  ACADEMY_COMMENT_ADDED
}

