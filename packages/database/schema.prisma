  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AcademyMembershipRole {
  INSTRUCTOR
  TEACHING_ASSISTANT
  STUDENT
}

enum AcademyMembershipStatus {
  INVITED
  ACTIVE
  REMOVED
  COMPLETED
}

enum AcademyLessonStatus {
  DRAFT
  PUBLISHED
}

enum AcademyLessonType {
  CLASSROOM
  WORKSPACE
  LAB
  CRITIQUE
  PRODUCTION
}

enum AcademyAssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AcademyDeliverableType {
  STORY_IDEA
  STORY_DNA
  CHARACTER_PROFILE
  SCENE_PLAN
  STORYBOARD
  IMAGE_SEQUENCE
  STORYBOOK
  FINAL_VIDEO
  ADVERT
