model MovieRenderJob {
  id                    String            @id @default(cuid())
  projectId             String
  project               StoryProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sequenceId            String
  sequence              StorySequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  userId                String
