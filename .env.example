# ─── Database (Supabase on VPS via Docker) ───────────────────────────────────
# Direct connection — used by Prisma for migrations and the main app
DATABASE_URL="postgresql://postgres:password@<vps-ip>:5432/postgres"
# Same as DATABASE_URL when not using a separate connection pooler
DIRECT_URL="postgresql://postgres:password@<vps-ip>:5432/postgres"

# ─── Custom JWT Authentication ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-64-char-random-secret"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-secret"

# ─── Google OAuth Sign-In (web + mobile) ─────────────────────────────────────
# Create an OAuth client at https://console.cloud.google.com/apis/credentials.
# The server accepts a comma-separated list so one codebase can serve the Web,
# iOS, and Android OAuth clients. The web sign-in button needs the public one.
GOOGLE_CLIENT_IDS="<web-client-id>.apps.googleusercontent.com"
# GOOGLE_CLIENT_IDS="<web>.apps.googleusercontent.com,<ios>.apps.googleusercontent.com,<android>.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="<web-client-id>.apps.googleusercontent.com"
# Mobile (Expo, EXPO_PUBLIC_* is inlined at build time):
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="<web-client-id>.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="<ios-client-id>.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="<android-client-id>.apps.googleusercontent.com"

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="raivstream-videos"

# Public CDN base URL — set up a custom domain in R2 > Settings > Custom Domains
# e.g. https://media.raivstream.com   (no trailing slash)
R2_PUBLIC_URL="https://media.raivstream.com"

# ─── Transcoding (optional, for HLS/quality variants) ────────────────────────
# Leave empty to use the "copy only" path (default).
TRANSCODE_WORKER_URL=""
TRANSCODE_WORKER_SECRET="generate-a-random-secret-here"

# ─── Redis Cache (Upstash) ───────────────────────────────────────────────────
UPSTASH_REDIS_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_TOKEN="your-token"

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs — create these in your Stripe dashboard
STRIPE_VIEWER_PREMIUM_PRICE_ID="price_..."
STRIPE_CREATOR_PREMIUM_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."

# ─── AI Video Generation ──────────────────────────────────────────────────────

# Nano Banana — text-to-video (add key when credentials received)
NANO_BANANA_API_KEY=""
NANO_BANANA_BASE_URL="https://api.nanobanana.ai/v1"

# Grok Imagine (xAI) — text-to-image generation
# Dashboard: https://console.x.ai
XAI_API_KEY=""

# Kling (Kuaishou) — coming soon, invite-only API
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""

# Higgsfield AI — coming soon, invite-only API
HIGGSFIELD_API_KEY=""

# ─── ElevenLabs (narration / dialogue voice — Phase 9B.3) ─────────────────────
# Server-only. Default OFF; also requires a configured `story:speech_generation`
# credit rate (fail-closed). Legacy `11_LABS` is accepted as a key alias.
ELEVENLABS_API_KEY=""
ELEVENLABS_TTS_ENABLED="false"
ELEVENLABS_TTS_MODEL="eleven_multilingual_v2"
ELEVENLABS_DEFAULT_VOICE_ID=""   # optional; defaults to the "Rachel" public voice

# ─── Lyria (background music — Phase 11) ──────────────────────────────────────
# Google DeepMind Lyria music generation via the Gemini API (reuses GEMINI_API_KEY).
# Default OFF; also requires a configured `story:audio_generation` credit rate.
LYRIA_MUSIC_ENABLED="false"
LYRIA_MUSIC_MODEL="lyria-3-clip-preview"   # or lyria-3-pro-preview (full length)

# ─── fal.ai Media Provider (Flux 2 / MiniMax H3-Max / VEED Fabric) ────────────
# Serverless media generation. Default-off / fail-closed: no live call leaves the
# process unless BOTH the master switch and the real-calls switch are on, a
# per-capability switch is on, FAL_MAX_REQUESTS > 0, and FAL_KEY is present.
# Dashboard: https://fal.ai/dashboard/keys
FAL_KEY=""
FAL_MEDIA_PROVIDER_ENABLED="false"
FAL_REAL_PROVIDER_CALLS_ENABLED="false"
FAL_IMAGE_ENABLED="false"        # fal-ai/flux-2 (text-to-image)
FAL_VIDEO_ENABLED="false"        # minimax/h3-max/image-to-video (image-to-video)
FAL_UGC_ENABLED="false"          # veed/fabric-1.0 (talking-video lip-sync)
FAL_MAX_REQUESTS="0"             # hard cap on provider submissions (0 = none)
FAL_USE_PRODUCTION_STORAGE="false"  # keep false to write staging output to an isolated R2 prefix

# ─── RunPod (LTX-Video 2 + Wan 2.5 inference) ────────────────────────────────
# Dashboard: https://runpod.io — Settings → API Keys
RUNPOD_API_KEY=""

# Network Volume — create once, mount to all pods at /runpod-volume
# Stores models, ComfyUI custom nodes, and generated outputs (~50–60 GB SSD)
RUNPOD_NETWORK_VOLUME_ID=""   # e.g. abcdef123456  (for reference; not used in code)

# ── LTX-Video 2 Serverless Endpoint ──────────────────────────────────────────
# Deploy guide: see packages/api/src/lib/generators/ltx2.ts header
RUNPOD_LTX2_ENDPOINT_ID=""    # e.g. abc12xyz  (found in RunPod → Serverless → your endpoint)

# Inference mode: "comfyui" (default) sends ComfyUI workflow JSON
#                 "handler"  sends flat JSON to a custom handler.py
RUNPOD_LTX2_MODE="comfyui"

# Model filenames on the Network Volume (under /runpod-volume/ComfyUI/models/)
RUNPOD_LTX2_CHECKPOINT="ltx-video-2b-0.9.6.safetensors"
RUNPOD_LTX2_CLIP="t5xxl_fp8_e4m3fn.safetensors"

# Generation quality tuning
RUNPOD_LTX2_STEPS="30"       # inference steps (higher = better quality, slower)
RUNPOD_LTX2_CFG="3.0"        # guidance scale (3.0 recommended for LTX-Video 2)
RUNPOD_LTX2_FPS="25"         # output FPS

# ── Wan 2.5 Serverless Endpoint ───────────────────────────────────────────────
# Deploy guide: see packages/api/src/lib/generators/wan25.ts header
RUNPOD_WAN25_ENDPOINT_ID=""   # e.g. def34abc

RUNPOD_WAN25_MODE="comfyui"

# Model filenames (GGUF quantised for 24 GB GPU compatibility)
RUNPOD_WAN25_UNET="wan2.1-t2v-14b-q4_k_m.gguf"         # ~8 GB, RTX 4090 friendly
RUNPOD_WAN25_TEXT_ENCODER="umt5-xxl-encoder-q8_0.gguf"  # ~12 GB
RUNPOD_WAN25_VAE="wan_2.1_vae.safetensors"              # ~1 GB

RUNPOD_WAN25_STEPS="20"
RUNPOD_WAN25_CFG="6.0"
RUNPOD_WAN25_FPS="16"

# ── Flux.1 (Black Forest Labs) ─────────────────────────────────────────────────
# ComfyUI worker on RunPod — image generation (RTX 4090 / 24 GB GPU)
# Model files on Network Volume:
#   /runpod-volume/models/unet/flux1-dev.safetensors
#   /runpod-volume/models/clip/clip_l.safetensors
#   /runpod-volume/models/clip/t5xxl_fp8_e4m3fn.safetensors
#   /runpod-volume/models/vae/ae.safetensors
RUNPOD_FLUX_ENDPOINT_ID=""
RUNPOD_FLUX_MODE="comfyui"
RUNPOD_FLUX_UNET="flux1-dev.safetensors"
RUNPOD_FLUX_CLIP_L="clip_l.safetensors"
RUNPOD_FLUX_T5="t5xxl_fp8_e4m3fn.safetensors"
RUNPOD_FLUX_VAE="ae.safetensors"
RUNPOD_FLUX_STEPS="20"
RUNPOD_FLUX_GUIDANCE="3.5"

# ── HunyuanVideo (Tencent) ─────────────────────────────────────────────────────
# ComfyUI worker on RunPod — video generation (A100 SXM 40 GB GPU required)
# Model files on Network Volume:
#   /runpod-volume/models/unet/hunyuan_video_720_cfgdistill_fp8_e4m3fn.safetensors
#   /runpod-volume/models/vae/hunyuan_video_vae_bf16.safetensors
#   (LLM + CLIP text encoders loaded via DownloadAndLoadHyVideoTextEncoder node)
# Custom nodes: kijai/ComfyUI-HunyuanVideoWrapper + ComfyUI-VideoHelperSuite
RUNPOD_HUNYUAN_ENDPOINT_ID=""
RUNPOD_HUNYUAN_MODE="comfyui"
RUNPOD_HUNYUAN_CHECKPOINT="hunyuan_video_720_cfgdistill_fp8_e4m3fn.safetensors"
RUNPOD_HUNYUAN_VAE="hunyuan_video_vae_bf16.safetensors"
RUNPOD_HUNYUAN_STEPS="30"
RUNPOD_HUNYUAN_CFG="6.0"
RUNPOD_HUNYUAN_FPS="24"

# ── CogVideoX (Zhipu AI / THUDM) ──────────────────────────────────────────────
# ComfyUI worker on RunPod — video generation (RTX 4090 / A100 GPU)
# Model files on Network Volume:
#   /runpod-volume/models/CogVideo/cogvideox_5b.safetensors
#   /runpod-volume/models/vae/cogvideox_vae.safetensors
#   /runpod-volume/models/text_encoders/t5xxl_fp16.safetensors
# Custom nodes: ComfyUI-VideoHelperSuite
RUNPOD_COGVIDEOX_ENDPOINT_ID=""
RUNPOD_COGVIDEOX_MODE="comfyui"
RUNPOD_COGVIDEOX_CHECKPOINT="cogvideox_5b.safetensors"
RUNPOD_COGVIDEOX_VAE="cogvideox_vae.safetensors"
RUNPOD_COGVIDEOX_T5="t5xxl_fp16.safetensors"
RUNPOD_COGVIDEOX_STEPS="50"
RUNPOD_COGVIDEOX_CFG="6.0"
RUNPOD_COGVIDEOX_FPS="8"

# ── Dev Pod IDs (for manual stop via app UI — not used in production) ─────────
# Get pod IDs from RunPod Dashboard → Pods → click a pod → copy ID
# These are dev/test pods; production uses the Serverless endpoints above
RUNPOD_LTX2_POD_ID=""        # fill only if running a persistent dev pod
RUNPOD_WAN25_POD_ID=""       # fill only if running a persistent dev pod

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="..."
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# ─── PostHog Analytics ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Application URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Mobile API URL — use your VPS IP or local machine IP when running Expo
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ─── Vercel (production only) ─────────────────────────────────────────────────
VERCEL_URL=""
VERCEL_ENV=""

# ─── Expo Mobile ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_PROJECT_ID="your-expo-project-id"

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_LIVE_STREAMING="false"

# Credit reserve → settle → release lifecycle (Phase §7.5). Default OFF.
# When false (default), generation uses deduct-before-submit + refund-on-failure.
# Enabling requires the financial policy decision (settlement deltas, reconciliation).
CREDIT_RESERVE_SETTLE_ENABLED="false"

# ─── Reliability / backpressure (Phase 15) ────────────────────────────────────
# Per-provider submission limits (in-process). 0 = unlimited (default).
PROVIDER_MAX_CONCURRENCY="0"      # max simultaneous in-flight submits per provider
PROVIDER_MIN_INTERVAL_MS="0"      # minimum spacing between submits per provider
# Movie Builder per-shot retry attempts before failing the job (default 2).
MOVIE_RENDER_SHOT_ATTEMPTS="2"
# Persist per-shot segments to R2 to resume a failed render (default on; set
# "false" to always re-render from scratch).
MOVIE_RENDER_SEGMENT_RESUME="true"

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV="development"
