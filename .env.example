# Database
DATABASE_URL="postgresql://user:password@localhost:5432/raivstream"
DATABASE_REPLICA_URL="postgresql://user:password@localhost:5432/raivstream" # For read replicas (production)

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# For Expo mobile app
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="..."

# S3 Storage
S3_BUCKET_NAME="raivstream-videos"
S3_REGION="us-east-1"

# CloudFront CDN
CLOUDFRONT_DOMAIN="d1234567890.cloudfront.net"
CLOUDFRONT_DISTRIBUTION_ID="E1234567890ABC"

# AWS MediaConvert
AWS_MEDIACONVERT_ENDPOINT="https://abc123.mediaconvert.us-east-1.amazonaws.com"
AWS_MEDIACONVERT_ROLE="arn:aws:iam::123456789:role/MediaConvertRole"
AWS_MEDIACONVERT_QUEUE="arn:aws:mediaconvert:us-east-1:123456789:queues/Default"

# Redis Cache (Upstash)
UPSTASH_REDIS_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_TOKEN="your-token"

# Stripe Payments
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs
STRIPE_VIEWER_PREMIUM_PRICE_ID="price_..."
STRIPE_CREATOR_PREMIUM_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."

# Inngest Background Jobs
INNGEST_EVENT_KEY="your-event-key"
INNGEST_SIGNING_KEY="your-signing-key"

# Sentry Error Tracking
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="..."
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Vercel (Production only)
VERCEL_URL=""
VERCEL_ENV=""

# Expo (Mobile)
EXPO_PUBLIC_PROJECT_ID="your-expo-project-id"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_LIVE_STREAMING="false"

# Environment
NODE_ENV="development"
