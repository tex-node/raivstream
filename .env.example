# ─── Database (Supabase on VPS via Docker) ───────────────────────────────────
# Direct connection — used by Prisma for migrations and the main app
DATABASE_URL="postgresql://postgres:password@<vps-ip>:5432/postgres"
# Same as DATABASE_URL when not using a separate connection pooler
DIRECT_URL="postgresql://postgres:password@<vps-ip>:5432/postgres"

# ─── Custom JWT Authentication ───────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="replace-with-64-char-random-secret"
JWT_REFRESH_SECRET="replace-with-different-64-char-random-secret"

# ─── Cloudflare R2 Storage ───────────────────────────────────────────────────
# S3-compatible endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="raivstream-videos"

# Public CDN base URL — set up a custom domain in R2 > Settings > Custom Domains
# e.g. https://media.raivstream.com   (no trailing slash)
R2_PUBLIC_URL="https://media.raivstream.com"

# ─── Transcoding (optional, for HLS/quality variants) ────────────────────────
# Leave empty to use the "copy only" path (default).
TRANSCODE_WORKER_URL=""
TRANSCODE_WORKER_SECRET="generate-a-random-secret-here"

# ─── Redis Cache (Upstash) ───────────────────────────────────────────────────
UPSTASH_REDIS_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_TOKEN="your-token"

# ─── Stripe Payments ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Stripe Price IDs — create these in your Stripe dashboard
STRIPE_VIEWER_PREMIUM_PRICE_ID="price_..."
STRIPE_CREATOR_PREMIUM_PRICE_ID="price_..."
STRIPE_ULTIMATE_PRICE_ID="price_..."

# ─── AI Video Generation ──────────────────────────────────────────────────────

# Nano Banana — text-to-video (add key when credentials received)
NANO_BANANA_API_KEY=""
NANO_BANANA_BASE_URL="https://api.nanobanana.ai/v1"

# Grok Imagine (xAI) — text-to-image generation
# Dashboard: https://console.x.ai
XAI_API_KEY=""

# Kling (Kuaishou) — coming soon, invite-only API
KLING_ACCESS_KEY=""
KLING_SECRET_KEY=""

# Higgsfield AI — coming soon, invite-only API
HIGGSFIELD_API_KEY=""

# ─── RunPod (LTX-Video 2 + Wan 2.5 inference) ────────────────────────────────
# Dashboard: https://runpod.io — Settings → API Keys
RUNPOD_API_KEY=""

# Network Volume — create once, mount to all pods at /runpod-volume
# Stores models, ComfyUI custom nodes, and generated outputs (~50–60 GB SSD)
RUNPOD_NETWORK_VOLUME_ID=""   # e.g. abcdef123456  (for reference; not used in code)

# ── LTX-Video 2 Serverless Endpoint ──────────────────────────────────────────
# Deploy guide: see packages/api/src/lib/generators/ltx2.ts header
RUNPOD_LTX2_ENDPOINT_ID=""    # e.g. abc12xyz  (found in RunPod → Serverless → your endpoint)

# Inference mode: "comfyui" (default) sends ComfyUI workflow JSON
#                 "handler"  sends flat JSON to a custom handler.py
RUNPOD_LTX2_MODE="comfyui"

# Model filenames on the Network Volume (under /runpod-volume/ComfyUI/models/)
RUNPOD_LTX2_CHECKPOINT="ltx-video-2b-0.9.6.safetensors"
RUNPOD_LTX2_CLIP="t5xxl_fp8_e4m3fn.safetensors"

# Generation quality tuning
RUNPOD_LTX2_STEPS="30"       # inference steps (higher = better quality, slower)
RUNPOD_LTX2_CFG="3.0"        # guidance scale (3.0 recommended for LTX-Video 2)
RUNPOD_LTX2_FPS="25"         # output FPS

# ── Wan 2.5 Serverless Endpoint ───────────────────────────────────────────────
# Deploy guide: see packages/api/src/lib/generators/wan25.ts header
RUNPOD_WAN25_ENDPOINT_ID=""   # e.g. def34abc

RUNPOD_WAN25_MODE="comfyui"

# Model filenames (GGUF quantised for 24 GB GPU compatibility)
RUNPOD_WAN25_UNET="wan2.1-t2v-14b-q4_k_m.gguf"         # ~8 GB, RTX 4090 friendly
RUNPOD_WAN25_TEXT_ENCODER="umt5-xxl-encoder-q8_0.gguf"  # ~12 GB
RUNPOD_WAN25_VAE="wan_2.1_vae.safetensors"              # ~1 GB

RUNPOD_WAN25_STEPS="20"
RUNPOD_WAN25_CFG="6.0"
RUNPOD_WAN25_FPS="16"

# ── Dev Pod IDs (for manual stop via app UI — not used in production) ─────────
# Get pod IDs from RunPod Dashboard → Pods → click a pod → copy ID
# These are dev/test pods; production uses the Serverless endpoints above
RUNPOD_LTX2_POD_ID=""        # fill only if running a persistent dev pod
RUNPOD_WAN25_POD_ID=""       # fill only if running a persistent dev pod

# ─── Sentry Error Tracking ───────────────────────────────────────────────────
SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="..."
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."

# ─── PostHog Analytics ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY="phc_..."
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ─── Application URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
# Mobile API URL — use your VPS IP or local machine IP when running Expo
EXPO_PUBLIC_API_URL="http://localhost:3000"

# ─── Vercel (production only) ─────────────────────────────────────────────────
VERCEL_URL=""
VERCEL_ENV=""

# ─── Expo Mobile ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_PROJECT_ID="your-expo-project-id"

# ─── Feature Flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_LIVE_STREAMING="false"

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV="development"
