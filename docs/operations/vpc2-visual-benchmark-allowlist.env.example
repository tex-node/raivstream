# VPC-2 visual-quality benchmark allowlist.
#
# STAGING-ONLY TEMPLATE. This file is NOT loaded by the Next.js app (Next loads
# .env / .env.local / .env.<NODE_ENV>, never this filename). It is reserved for a
# future isolated benchmark task and contains NO credentials.
#
# Default state is fully disabled. Do not flip ALLOW_REAL_PROVIDER to true until
# every provider-isolation requirement in
# docs/operations/vpc2-provider-isolation-2026-09-12.md is satisfied.

# Master switch for the benchmark harness.
VPC2_VISUAL_BENCHMARK_ENABLED=false

# Hard request cap (image-only). 32 V1 + 32 V2 = 64.
VPC2_VISUAL_BENCHMARK_MAX_REQUESTS=64

# Must remain false until a dedicated non-production account/key exists.
VPC2_VISUAL_BENCHMARK_ALLOW_REAL_PROVIDER=false

# Image generation only. No video, no audio.
VPC2_VISUAL_BENCHMARK_IMAGE_ONLY=true

# Never write benchmark output to the production R2 bucket/prefix.
VPC2_VISUAL_BENCHMARK_NO_PRODUCTION_STORAGE=true

# --- Non-secret identifiers (fill only after a dedicated non-prod provider is provisioned) ---
# VPC2_VISUAL_BENCHMARK_PROVIDER_ACCOUNT=<non-production account/project id>
# VPC2_VISUAL_BENCHMARK_PROVIDER_ENDPOINT=<dedicated non-production endpoint>
# The secret value itself MUST live outside Git; record only the env var NAME here.
# VPC2_VISUAL_BENCHMARK_CREDENTIAL_ENV_VAR=<name of the env var holding the dedicated key>

# --- Storage isolation (only when a non-prod bucket is provisioned) ---
# VPC2_VISUAL_BENCHMARK_R2_BUCKET=<non-production bucket>
# VPC2_VISUAL_BENCHMARK_R2_PREFIX=vpc2-benchmark/
